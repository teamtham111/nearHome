# NearHome environment template. This file contains names and safe example
# values only. Never commit a real .env file or place secrets in NEXT_PUBLIC_*.

# Application — required by API locally and on Cloud Run
APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8080
RATE_LIMIT_PER_MINUTE=60
SECRET_KEY=change-me-in-production-use-a-random-32-character-secret

# Frontend / CORS — WEB_URL and CORS_ORIGINS are required in production API.
# Set them to the exact deployed Vercel HTTPS origin on Cloud Run.
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database — required by API. Cloud Run normally uses the Supabase Session
# Pooler URL with sslmode=require; the app adds postgresql+psycopg when needed.
DATABASE_URL=postgresql+psycopg://nearhome:nearhome@localhost:5432/nearhome
DATABASE_URL_TEST=postgresql+psycopg://nearhome:nearhome@localhost:5432/nearhome_test
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_RECYCLE_SECONDS=300

# Execution mode — inline is the Cloud Run default and requires no Redis.
# Set arq only for local/future worker execution, where REDIS_URL is required.
JOB_EXECUTION_MODE=inline
MAX_CONCURRENT_ENRICHMENTS=1
REDIS_URL=

# Smart Paste / browser fallback — API only. Chromium is installed in the API image.
ENABLE_PLAYWRIGHT_FALLBACK=true
PLAYWRIGHT_TIMEOUT_SECONDS=25
PLAYWRIGHT_MAX_CONCURRENCY=1
GROQ_MODEL=openai/gpt-oss-20b
SMART_PASTE_PROMPT_VERSION=1.0.0
SMART_PASTE_SCHEMA_VERSION=1.0.0
SMART_PASTE_PIPELINE_VERSION=1.0.0

# Groq — required for live Smart Paste on API/Cloud Run; secret.
GROQ_API_KEY=

# Google — required for live routing/places on API/Cloud Run; secret.
GOOGLE_MAPS_API_KEY=

# OneMap — required for live API geocoding; secret. The existing Vercel
# server-side /api/geocode route also needs these values as non-NEXT_PUBLIC vars.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# LTA/data.gov.sg — LTA is optional and secret. data.gov.sg is public; its
# optional key raises limits but is not required or invented by this project.
LTA_ACCOUNT_KEY=
DATA_GOV_SG_API_KEY=
HDB_CARPARK_AVAILABILITY_URL=https://api.data.gov.sg/v1/transport/carpark-availability
HDB_CARPARK_AVAILABILITY_CACHE_SECONDS=60
HDB_CARPARK_AVAILABILITY_STALE_MINUTES=15
HDB_CARPARK_HISTORY_MIN_SAMPLES=5

# Model / fixtures — no environment path is required. Docker packages the
# repository-managed data_pipeline/fixtures directory for CatBoost and evidence.

# Vercel public web build variables — non-secret and build-time only.
NEXT_PUBLIC_DEPLOYMENT_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
# Legacy local compatibility only; do not set this in production.
NEXT_PUBLIC_API_URL=http://localhost:8000
