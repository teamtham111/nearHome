# Application. Use `production` only in the deployed API service.
APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql+psycopg://nearhome:nearhome@localhost:5432/nearhome
DATABASE_URL_TEST=postgresql+psycopg://nearhome:nearhome@localhost:5432/nearhome_test

# Redis
REDIS_URL=redis://localhost:6379/0

# External providers (server-side only — never expose to browser)
GOOGLE_MAPS_API_KEY=
DATA_GOV_SG_API_KEY=
HDB_CARPARK_AVAILABILITY_URL=https://api.data.gov.sg/v1/transport/carpark-availability
HDB_CARPARK_AVAILABILITY_CACHE_SECONDS=60
HDB_CARPARK_AVAILABILITY_STALE_MINUTES=15
HDB_CARPARK_HISTORY_MIN_SAMPLES=5
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
LTA_ACCOUNT_KEY=
GROQ_API_KEY=

# LLM / Smart Paste
GROQ_MODEL=openai/gpt-oss-20b
SMART_PASTE_PROMPT_VERSION=1.0.0
SMART_PASTE_SCHEMA_VERSION=1.0.0
SMART_PASTE_PIPELINE_VERSION=1.0.0

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
RATE_LIMIT_PER_MINUTE=60

# Frontend (public, non-secret). These values are inlined at the web build.
# For a deployment set NEXT_PUBLIC_DEPLOYMENT_ENV=production and an HTTPS API URL.
NEXT_PUBLIC_DEPLOYMENT_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Legacy local variable retained during migration. Do not set it in production.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
